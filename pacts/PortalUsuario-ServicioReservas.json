{
  "consumer": {
    "name": "PortalUsuario"
  },
  "interactions": [
    {
      "description": "una solicitud para crear una reserva con horas inválidas",
      "pending": false,
      "providerStates": [
        {
          "name": "el sistema esta preparado para crear una nueva reserva valida"
        }
      ],
      "request": {
        "body": {
          "content": {
            "fecha": "2026-10-01",
            "horas": 0,
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/reservas"
      },
      "response": {
        "body": {
          "content": {
            "error": "La cantidad de horas es inválida"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "una solicitud para crear una reserva válida",
      "pending": false,
      "providerStates": [
        {
          "name": "el sistema esta preparado para crear una nueva reserva valida"
        }
      ],
      "request": {
        "body": {
          "content": {
            "fecha": "2026-10-01",
            "horas": 2,
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/reservas"
      },
      "response": {
        "body": {
          "content": {
            "estado": "activa",
            "fecha": "2026-10-01",
            "horas": 2,
            "id": "R-1001",
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "R-\\d+"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ServicioReservas"
  }
}