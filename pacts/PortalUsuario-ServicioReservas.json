{
  "consumer": {
    "name": "PortalUsuario"
  },
  "interactions": [
    {
      "description": "una solicitud de reservas para U100",
      "pending": false,
      "providerStates": [
        {
          "name": "el usuario U100 posee una reserva activa"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/reservas",
        "query": {
          "usuario": [
            "U100"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "estado": "activa",
              "fecha": "2026-10-01",
              "horas": 2,
              "id": "R-1001",
              "sala": "SALA-1",
              "usuarioId": "U100"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].fecha": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].horas": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].sala": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "una solicitud de reservas para U200",
      "pending": false,
      "providerStates": [
        {
          "name": "el usuario U200 no posee ninguna reserva"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/reservas",
        "query": {
          "usuario": [
            "U200"
          ]
        }
      },
      "response": {
        "body": {
          "content": [],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "una solicitud para crear una reserva con horas inválidas",
      "pending": false,
      "providerStates": [
        {
          "name": "el sistema esta preparado para crear una nueva reserva valida"
        }
      ],
      "request": {
        "body": {
          "content": {
            "fecha": "2026-10-01",
            "horas": 0,
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/reservas"
      },
      "response": {
        "body": {
          "content": {
            "error": "La cantidad de horas es inválida"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 400
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "una solicitud para crear una reserva válida",
      "pending": false,
      "providerStates": [
        {
          "name": "el sistema esta preparado para crear una nueva reserva valida"
        }
      ],
      "request": {
        "body": {
          "content": {
            "fecha": "2026-10-01",
            "horas": 2,
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/reservas"
      },
      "response": {
        "body": {
          "content": {
            "estado": "activa",
            "fecha": "2026-10-01",
            "horas": 2,
            "id": "R-1001",
            "sala": "SALA-1",
            "usuarioId": "U100"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "R-\\d+"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.7",
      "models": "1.3.15"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ServicioReservas"
  }
}